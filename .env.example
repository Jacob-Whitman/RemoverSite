# ============================================================
# FRONTEND PUBLIC VARIABLES (safe to include in browser build)
# ============================================================

# Supabase project URL — found in Supabase dashboard > Settings > API
VITE_SUPABASE_URL=

# Supabase anon/public key — safe for browser; RLS enforces access
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile SITE key — public, displayed in browser widget
VITE_TURNSTILE_SITE_KEY=

# App environment tag (development | staging | production)
VITE_APP_ENV=development

# GitHub Pages base path — use '/' for custom domain or org pages root
# Use '/<repo-name>/' for project pages without a custom domain
VITE_BASE_PATH=/

# ============================================================
# SUPABASE EDGE FUNCTION SECRETS (server-side only, never browser)
# Set these in the Supabase dashboard > Edge Functions > Secrets
# ============================================================

# CLOUDFLARE_TURNSTILE_SECRET_KEY=   ← set in Supabase secrets, NOT here
# SUPABASE_SERVICE_ROLE_KEY=         ← set in Supabase secrets, NOT here
# SITE_URL=                          ← set in Supabase secrets, NOT here
